{# Contact & Reservation form.
   Posts to the site itself — nothing leaves for a third party, no captcha
   service, no remote script. What guards it: a field no one sees, the time
   taken to fill the form, and a limit per address. #}

{% set valeurs = formulaire.valeurs|default({}) %}
{% set champs = formulaire.champs|default({}) %}
{% set envoye = formulaire.envoye|default(false) %}

<section class="max-w-4xl mx-auto my-12 bg-white p-6 md:p-10 rounded-xl shadow-lg border border-gray-100" id="formulaire">

    {% if titre %}
        <h{{ niveau }} class="text-3xl font-heading font-bold text-vert-chene mb-2 text-center">{{ titre }}</h{{ niveau }}>
    {% else %}
        <h2 class="text-3xl font-heading font-bold text-vert-chene mb-2 text-center">Demande de réservation</h2>
    {% endif %}

    {% if bloc.texte %}
        <div class="text-center text-gray-600 mb-8 font-sans">
            {{ bloc.texte|raw }}
        </div>
    {% endif %}

    {% if envoye %}
        <div class="bg-vert-tendre border border-vert-chene text-vert-chene p-4 rounded-md mb-6 font-medium text-center" role="status">
            Votre demande a bien été envoyée. Nous vous recontacterons très vite pour confirmer les disponibilités.
        </div>
    {% endif %}

    {% if not contactActif|default(false) %}
        {# Configuration missing: fall back on the details, which always work. #}
        <ul class="text-center space-y-2 font-medium text-lg text-gris-ardoise">
            {% if site.telephone %}
                <li>📞 <a href="tel:{{ tel_href(site.telephone) }}" class="hover:text-vert-chene">{{ site.telephone }}</a></li>
            {% endif %}
            {% if site.email %}
                <li>✉️ <a href="mailto:{{ site.email }}" class="hover:text-vert-chene">{{ site.email }}</a></li>
            {% endif %}
        </ul>
    {% else %}

        {% if formulaire.erreur is defined %}
            <div class="bg-red-50 border border-red-200 text-red-700 p-4 rounded-md mb-6 font-medium text-center" role="alert">
                {{ formulaire.erreur }}
            </div>
        {% endif %}

        <form class="space-y-6 font-sans" method="post" action="/contact" novalidate>

            <input type="hidden" name="jeton" value="{{ jetonContact }}">
            <input type="hidden" name="retour" value="{{ slug == accueilSlug|default('accueil') ? '/' : '/' ~ slug }}">

            {# Piège anti-spam invisible #}
            <div class="hidden" aria-hidden="true">
                <label for="site_web">Ne pas remplir ce champ</label>
                <input type="text" id="site_web" name="site_web" tabindex="-1" autocomplete="off">
            </div>

            <!-- Coordonnées -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label for="contact-nom" class="block text-sm font-semibold text-gris-ardoise mb-1">Nom et Prénom *</label>
                    <input type="text" id="contact-nom" name="nom" required autocomplete="name"
                           class="w-full border {% if champs.nom is defined %}border-red-500{% else %}border-gray-300{% endif %} rounded-md p-2 focus:ring-2 focus:ring-vert-chene outline-none"
                           value="{{ valeurs.nom|default('') }}"
                           {% if champs.nom is defined %}aria-invalid="true" aria-describedby="erreur-nom"{% endif %}>
                    {% if champs.nom is defined %}<span class="text-red-500 text-xs mt-1 block" id="erreur-nom">{{ champs.nom }}</span>{% endif %}
                </div>
                
                <div>
                    <label for="contact-email" class="block text-sm font-semibold text-gris-ardoise mb-1">Adresse E-mail *</label>
                    <input type="email" id="contact-email" name="email" required autocomplete="email"
                           class="w-full border {% if champs.email is defined %}border-red-500{% else %}border-gray-300{% endif %} rounded-md p-2 focus:ring-2 focus:ring-vert-chene outline-none"
                           value="{{ valeurs.email|default('') }}"
                           {% if champs.email is defined %}aria-invalid="true" aria-describedby="erreur-email"{% endif %}>
                    {% if champs.email is defined %}<span class="text-red-500 text-xs mt-1 block" id="erreur-email">{{ champs.email }}</span>{% endif %}
                </div>

                <div>
                    <label for="contact-telephone" class="block text-sm font-semibold text-gris-ardoise mb-1">Téléphone *</label>
                    <input type="tel" id="contact-telephone" name="telephone" required autocomplete="tel"
                           class="w-full border border-gray-300 rounded-md p-2 focus:ring-2 focus:ring-vert-chene outline-none"
                           value="{{ valeurs.telephone|default('') }}">
                </div>

                <div>
                    <label for="contact-hebergement" class="block text-sm font-semibold text-gris-ardoise mb-1">Hébergement souhaité *</label>
                    <select id="contact-hebergement" name="hebergement" required class="w-full border border-gray-300 rounded-md p-2 focus:ring-2 focus:ring-vert-chene outline-none bg-white">
                        <option value="" {% if valeurs.hebergement|default('') == '' %}selected{% endif %}>Sélectionnez une formule...</option>
                        <option value="Emplacement nu" {% if valeurs.hebergement|default('') == 'Emplacement nu' %}selected{% endif %}>Emplacement nu (Tente / Caravane)</option>
                        <option value="Emplacement Camping-car" {% if valeurs.hebergement|default('') == 'Emplacement Camping-car' %}selected{% endif %}>Emplacement Camping-car</option>
                        <option value="Mobil-home 4 places" {% if valeurs.hebergement|default('') == 'Mobil-home 4 places' %}selected{% endif %}>Mobil-home 4 personnes</option>
                        <option value="Mobil-home 6 places" {% if valeurs.hebergement|default('') == 'Mobil-home 6 places' %}selected{% endif %}>Mobil-home 6 personnes</option>
                        <option value="Tente Lodge" {% if valeurs.hebergement|default('') == 'Tente Lodge' %}selected{% endif %}>Tente Lodge Safari</option>
                    </select>
                </div>
            </div>

            <!-- Dates de séjour -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 p-4 bg-vert-tendre rounded-lg">
                <div>
                    <label for="contact-arrivee" class="block text-sm font-semibold text-vert-chene mb-1">Date d'arrivée *</label>
                    <input type="date" id="contact-arrivee" name="date_arrivee" required class="w-full border border-gray-300 rounded-md p-2 focus:ring-2 focus:ring-vert-chene outline-none" value="{{ valeurs.date_arrivee|default('') }}">
                </div>
                <div>
                    <label for="contact-depart" class="block text-sm font-semibold text-vert-chene mb-1">Date de départ *</label>
                    <input type="date" id="contact-depart" name="date_depart" required class="w-full border border-gray-300 rounded-md p-2 focus:ring-2 focus:ring-vert-chene outline-none" value="{{ valeurs.date_depart|default('') }}">
                </div>
            </div>

            <!-- Composition et Options -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                <div>
                    <label for="contact-adultes" class="block text-sm font-semibold text-gris-ardoise mb-1">Adultes *</label>
                    <input type="number" id="contact-adultes" name="adultes" min="1" value="{{ valeurs.adultes|default('2') }}" required class="w-full border border-gray-300 rounded-md p-2 outline-none">
                </div>
                <div>
                    <label for="contact-enfants" class="block text-sm font-semibold text-gris-ardoise mb-1">Enfants</label>
                    <input type="number" id="contact-enfants" name="enfants" min="0" value="{{ valeurs.enfants|default('0') }}" class="w-full border border-gray-300 rounded-md p-2 outline-none">
                </div>
                <div class="col-span-2 flex items-center mt-6">
                    <input type="checkbox" id="contact-animal" name="animal" value="Oui" class="w-5 h-5 text-vert-chene border-gray-300 rounded focus:ring-vert-chene" {% if valeurs.animal|default('') == 'Oui' %}checked{% endif %}>
                    <label for="contact-animal" class="ml-2 text-sm font-semibold text-gris-ardoise">Je viens avec un animal</label>
                </div>
            </div>

            <!-- Message libre -->
            <div>
                <label for="contact-message" class="block text-sm font-semibold text-gris-ardoise mb-1">Demande particulière</label>
                <textarea id="contact-message" name="message" rows="4" 
                          class="w-full border {% if champs.message is defined %}border-red-500{% else %}border-gray-300{% endif %} rounded-md p-2 focus:ring-2 focus:ring-vert-chene outline-none"
                          {% if champs.message is defined %}aria-invalid="true" aria-describedby="erreur-message"{% endif %}>{{ valeurs.message|default('') }}</textarea>
                {% if champs.message is defined %}<span class="text-red-500 text-xs mt-1 block" id="erreur-message">{{ champs.message }}</span>{% endif %}
            </div>

            <!-- Consentement RGPD -->
            <div class="bg-gray-50 p-4 rounded-md">
                <div class="flex items-start">
                    <input type="checkbox" id="contact-consentement" name="consentement" value="1" required class="mt-1 w-5 h-5 text-vert-chene border-gray-300 rounded focus:ring-vert-chene"
                           {% if champs.consentement is defined %}aria-invalid="true" aria-describedby="erreur-consentement"{% endif %}>
                    <label for="contact-consentement" class="ml-3 text-sm text-gray-600">
                        J’accepte que mes données soient conservées pour traiter ma demande de réservation.
                        <a href="/confidentialite" class="text-vert-chene underline hover:text-marron-ecorce">Politique de confidentialité</a>.
                    </label>
                </div>
                {% if champs.consentement is defined %}<span class="text-red-500 text-xs mt-2 block" id="erreur-consentement">{{ champs.consentement }}</span>{% endif %}
            </div>

            <!-- Bouton de soumission -->
            <div class="text-center pt-4">
                <button type="submit" class="bg-marron-ecorce hover:bg-orange-800 text-white text-lg font-bold py-3 px-10 rounded-full shadow-md transition transform hover:-translate-y-1">
                    Envoyer ma demande
                </button>
            </div>

        </form>

    {% endif %}

</section>