{# templates-client/blocs/hebergements.html.twig #}
{# Section affichant 3 cartes d'hébergements avec leurs détails #}
<section class="py-16 bg-vert-tendre text-center">
    
    <!-- Titre et Introduction globaux -->
    <h{{ niveau }} class="text-3xl font-heading font-bold text-vert-chene mb-4">{{ titre }}</h{{ niveau }}>
    {% if bloc.introduction %}
        <p class="text-gris-ardoise mb-12 max-w-2xl mx-auto">{{ bloc.introduction }}</p>
    {% endif %}

    <!-- Grille des 3 cartes -->
    <div class="max-w-7xl mx-auto px-4 grid grid-cols-1 md:grid-cols-3 gap-8 text-left">
        {% for carte in bloc.cartes %}
            <div class="bg-white rounded-xl shadow-md overflow-hidden flex flex-col">
              <!-- Image -->
                {% if carte.image.path is defined %}
                    {# On nettoie le texte alternatif de l'image pour l'accessibilité #}
                    <img src="/medias{{ carte.image.path }}" alt="{{ carte.titre|split('(')[0]|trim }}" class="w-full h-48 object-cover" width="800" height="600">
                {% endif %}
                
                <!-- Contenu de la carte -->
                <div class="p-6 flex flex-col flex-grow">
                    
                    <!-- Titre avec Badge dynamique -->
                    <h3 class="font-bold text-xl mb-4 text-vert-chene flex items-center flex-wrap gap-2">
                        {% if '(' in carte.titre %}
                            {% set titre_morceaux = carte.titre|split('(') %}
                            <span>{{ titre_morceaux[0]|trim }}</span>
                            <span class="bg-vert-tendre text-vert-chene text-sm font-bold px-3 py-1 rounded-full border border-vert-chene shadow-sm tracking-wide mt-1 md:mt-0">
                                {{ titre_morceaux[1]|replace({')': ''})|trim }}
                            </span>
                        {% else %}
                            <span>{{ carte.titre }}</span>
                        {% endif %}
                    </h3>
                    
                    <!-- Caractéristiques (WYSIWYG pour faire des listes à puces) -->
                    <div class="text-sm text-gris-ardoise mb-6 flex-grow">
                        {{ carte.caracteristiques|raw }}
                    </div>
                    <!-- Bouton de la carte -->
                    <a href="{{ carte.lien_url|default('#') }}" class="block w-full text-center border-2 border-vert-chene text-vert-chene font-bold py-2 rounded-full hover:bg-vert-chene hover:text-white transition">
                        {{ carte.lien_texte|default('Voir les détails') }}
                    </a>
                </div>
            </div>
        {% endfor %}
    </div>

    <!-- Bouton global en bas -->
    {% if bloc.bouton_texte %}
        <div class="mt-12">
            <a href="{{ bloc.bouton_url|default('#') }}" class="bg-marron-ecorce text-white px-8 py-3 rounded-full font-bold shadow-md hover:opacity-90 transition inline-block">
                {{ bloc.bouton_texte }}
            </a>
        </div>
    {% endif %}
</section>